# Sparkz env - copy to .env.local and fill. NEVER commit real values.

# --- Database backend switch (moving off Supabase, 14 Nov 2026) ---
# Unset: Supabase, as before. "neon": Neon Postgres plus Vercel Blob for uploads
# (src/lib/supabase/server.ts, src/lib/db/). An explicit flag, so connecting a store
# never moves the site to an empty database by accident.
SPARKZ_DB=

# --- Neon Postgres (SPARKZ_DB=neon). Vercel's Neon integration sets these. ---
# Server-only. DATABASE_URL is the pooled string the app uses; DATABASE_URL_UNPOOLED is
# for psql and the one-time copy script. A STORAGE_ prefix also works (STORAGE_DATABASE_URL).
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# --- Vercel Blob (uploads when SPARKZ_DB=neon). Connecting the store sets these. ---
# sparkz-blob is connected over OIDC (BLOB_STORE_ID, with Vercel's VERCEL_OIDC_TOKEN at
# runtime); a read-write token also works. Server-only.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# --- Supabase (the old store; used while SPARKZ_DB is unset) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=   # server-only, never sent to the browser

# --- Creator sessions (owner-by-FID; see docs/AUTH-PLAN.md) ---
# Signs the httpOnly session cookie minted after a verified Farcaster sign-in (Quick
# Auth JWT in the mini app, SIWF on the web). Server-only. At least 32 characters;
# sign-in is disabled while unset. Rotating it signs every creator out.
# Generate: openssl rand -hex 32
SPARKZ_SESSION_SECRET=

# --- Canonical origin (trusted base URL for outbound links) ---
# Used for outbound links. NEVER derived from the request Host header - a spoofed Host
# must not be able to inject a phishing domain.
# Set to your production origin, no trailing slash, for example https://trysparkz.com.
# Falls back to https://trysparkz.com when unset.
SPARKZ_ORIGIN=

# --- Wallet connect (Reown AppKit / WalletConnect) - makes mobile connect work ---
# Public projectId (free) from https://reown.com (Cloud). Safe as NEXT_PUBLIC.
NEXT_PUBLIC_REOWN_PROJECT_ID=

# --- Empire Builder (non-token empire rail; empirebuilder.world) ---
# Read/resolve empires needs no key. Deploying a tokenless empire is MAINNET-LIVE
# on Base and needs the API key + an owner wallet to sign (EIP-191). 2 deploys/
# wallet/24h. Leave blank until you deliberately deploy.
EMPIRE_API_KEY=
# The owner/signer wallet private key for tokenless deploys (server-side signer).
# SECRET. Only set when wiring live deploys - decide signer strategy first.
EMPIRE_OWNER_PRIVATE_KEY=

# --- Brand audit (OSS-repo Capsule import) ---
# Optional: raises the GitHub API rate limit and reaches private ZAO repos.
GITHUB_TOKEN=

# --- Farcaster ---
# Hypersnap node Sparkz reads Farcaster data from (docs/HYPERSNAP.md). Unset = the public
# read node https://haatz.quilibrium.com. Any Snapchain-compatible node works.
HYPERSNAP_NODE_URL=

# --- Farcaster Mini App manifest account association (sign with the Farcaster
# manifest tool at farcaster.xyz/~/developers; domain MUST be trysparkz.com) ---
FARCASTER_HEADER=
FARCASTER_PAYLOAD=
FARCASTER_SIGNATURE=

# --- Onchain / token (only when a Capsule graduates to a coin; Clanker adapter) ---
# Base RPC + Clanker are v1.5+; leave blank for the milestone-1 Capsule foundation.
BASE_RPC_URL=
CLANKER_API_KEY=

# --- Baraza TV (streaming media kit adapter - render a Capsule promo/recap as an
# AI-anchor video). When BARAZA_API_URL is UNSET the media-kit adapter runs in STUB
# mode: deterministic, no network, no spend - so the flow is testable before Baraza
# TV ships its API. Set the URL (and key) to flip to the live renderer, zero code
# change. Contract: docs/BARAZA-INTEGRATION.md ---
BARAZA_API_URL=
BARAZA_API_KEY=

# The first free hat (Hats Protocol, tree 226 on Optimism). HATS_MEMBER_HAT_ID is the hat
# as the Hats app shows it ("226.1.1.1.1.5"), hex or decimal. NO PRIVATE KEY: members claim
# the hat from their own wallet through the tree's claims module (MultiClaimsHatter). Set it
# up once in the Hats app: add the claims module, give it an admin hat above the Member hat,
# mark the Member hat claimable. Paste the module address below. Public, not a secret.
# Leave blank and /zao shows "Free hats open soon" or a disabled button.
HATS_MEMBER_HAT_ID=
NEXT_PUBLIC_HATS_CLAIMS_HATTER=
OPTIMISM_RPC_URL=
